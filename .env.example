# ============================================================
#  B&B Cassino Centrale — file di configurazione di esempio
#  Copia questo file in ".env" e riempi i valori tra <...>.
#  NON mettere mai il file .env su GitHub (contiene le password).
# ============================================================

APP_NAME="B&B Cassino Centrale"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://cassinocentrale.it

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_TIMEZONE=Europe/Rome

# ------------------------------------------------------------
#  Log
# ------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ------------------------------------------------------------
#  Database (MariaDB/MySQL su Hetzner + HestiaCP)
# ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<nome_database>
DB_USERNAME=<utente_database>
DB_PASSWORD=<password_database>

# ------------------------------------------------------------
#  Sessioni, cache, code
# ------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------
#  Email (SMTP) — Fase 4. Valori configurabili anche da admin.
# ------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=<host_smtp>
MAIL_PORT=587
MAIL_USERNAME=<utente_smtp>
MAIL_PASSWORD=<password_smtp>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@cassinocentrale.it"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------
#  Stripe — Fase 5 (pagamenti online). Lasciare vuoto per ora.
# ------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENABLED=false

# ------------------------------------------------------------
#  WhatsApp multi-provider — Fase 4 (SpotWab / UoZap / Hooki).
#  I valori veri si gestiranno dall'area admin.
# ------------------------------------------------------------
WHATSAPP_DEFAULT_PROVIDER=
WHATSAPP_ENABLED=false
# Numero mostrato dal pulsante "Chatta con noi" (formato internazionale, es. 393331234567)
WHATSAPP_CONTACT_NUMBER=

# ------------------------------------------------------------
#  Provider AI per il chatbot — Fase 6.
# ------------------------------------------------------------
AI_DEFAULT_PROVIDER=
AI_ENABLED=false

# ------------------------------------------------------------
#  Push notifications VAPID — Fase 7.
# ------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:info@cassinocentrale.it"

# ------------------------------------------------------------
#  Frontend (Vite)
# ------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
